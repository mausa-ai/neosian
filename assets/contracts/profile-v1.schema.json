{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosian.com/contracts/profile-v1.schema.json",
  "title": "Portable workspace profile 1 (parsed TOML)",
  "description": "The binary also checks byte limits, declared sources, distinct mount scopes/paths, scope/path grammar, selected skill paths and the capture namespace. Bindings and credential values are never portable profile fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_format", "workspace_id", "name", "sources", "mounts"],
  "properties": {
    "profile_format": {"const": 1},
    "workspace_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/alias"}},
    "mounts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/mount"}},
    "skills": {"type": "array", "maxItems": 256, "uniqueItems": true, "default": [], "items": {"type": "string", "maxLength": 4096, "pattern": "^(builtin:(handoff|upkeep)|/[^/]+/skills/[^/]+)$"}},
    "skill_pins": {"type":"object", "maxProperties":256, "propertyNames":{"pattern":"^/[^/]+/skills/[^/]+$"}, "additionalProperties":{"$ref":"#/$defs/skillPin"}},
    "context": {"$ref": "#/$defs/context"},
    "capture": {"$ref": "#/$defs/capture"},
    "history": {"$ref": "#/$defs/history"}
  },
  "$defs": {
    "skillPin": {"type":"object","additionalProperties":false,"required":["source","scope","version","sha256"],"properties":{"source":{"$ref":"#/$defs/alias"},"scope":{"type":"string","minLength":1},"version":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "alias": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "textList": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "conversation": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$", "not": {"enum": [".", ".."]}},
    "mount": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "scope", "path"],
      "properties": {
        "source": {"$ref": "#/$defs/alias"},
        "scope": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
        "access": {"enum": ["rw", "ro", "eo"], "default": "ro"},
        "injection": {"enum": ["index", "full", "none"], "default": "index"},
        "knowledge_policy": {"enum": ["all", "effective", "approved"], "default": "all"},
        "documents": {"$ref": "#/$defs/textList"}
      },
      "oneOf": [
        {"required": ["injection", "documents"], "properties": {"injection": {"const": "full"}, "documents": {"minItems": 1}}},
        {"properties": {"injection": {"enum": ["index", "none"]}, "documents": {"maxItems": 0}}}
      ]
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_chars": {"type": "integer", "minimum": 512, "maximum": 65536, "default": 8192},
        "mailbox": {"type": "boolean", "default": false}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["off", "local", "shared"], "default": "off"},
        "fields": {"type": "array", "maxItems": 5, "uniqueItems": true, "default": ["prompt", "assistant"], "items": {"enum": ["prompt", "assistant", "tool_inputs", "tool_outputs", "received_context"]}},
        "exclude_tools": {"$ref": "#/$defs/textList"},
        "remove_keys": {"$ref": "#/$defs/textList"},
        "replacements": {"type": "array", "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "to"],
          "properties": {"from": {"type": "string", "minLength": 1, "maxLength": 4096}, "to": {"type": "string", "maxLength": 4096}}
        }}
      }
    },
    "history": {
      "type": "object", "additionalProperties": false, "required": ["source", "scope"],
      "properties": {
        "source": {"$ref": "#/$defs/alias"},
        "scope": {"type": "string", "minLength": 1},
        "prefix": {"$ref": "#/$defs/conversation", "maxLength": 64},
        "conversations": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/conversation"}}
      },
      "oneOf": [
        {"required": ["prefix"], "properties": {"conversations": {"maxItems": 0}}},
        {"required": ["conversations"], "not": {"required": ["prefix"]}, "properties": {"conversations": {"minItems": 1}}}
      ]
    }
  }
}
